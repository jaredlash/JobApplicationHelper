<Window x:Class="JobApplicationHelper.Views.ComparePendingExperienceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:JobApplicationHelper.Converters"
        xmlns:viewmodels="clr-namespace:JobApplicationHelper.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewmodels:ComparePendingExperienceViewModel}"
        Title="Compare Current and Pending Experience Imports"
        Height="650"
        Width="800">

    <Window.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplayConverter" />
        <conv:DateRangeConverter x:Key="DateRangeConverter" />
        <conv:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />
    </Window.Resources>
    
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fixed headings -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Current Experience"
                   FontSize="16"
                   FontWeight="SemiBold"/>

            <Label Grid.Column="1"
                   Content="Pending Experience (new)"
                   FontSize="16"
                   FontWeight="SemiBold"/>
        </Grid>

        <!-- Fixed overview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="8"
                    Margin="2">
                <TextBlock Text="{Binding HeadingCurrent}"
                           FontWeight="SemiBold"/>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="8"
                    Margin="2">
                <TextBlock Text="{Binding HeadingPending}"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Scrollable comparison -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding ShowTitle, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowExperienceType, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowOrganization, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowDateRange, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowSummary, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowSkills, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowEvidence, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowContext, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowLinks, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                    <RowDefinition Height="{Binding ShowNotes, Converter={StaticResource BooleanToGridLengthConverter}}"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <Border Grid.Row="0" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Title" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Current.Title}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Title" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Pending.Title}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Type -->
                <Border Grid.Row="1" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Type" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Current.Type, Converter={StaticResource EnumDisplayConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Type" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Pending.Type, Converter={StaticResource EnumDisplayConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Organization -->
                <Border Grid.Row="2" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Organization" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Current.Organization}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Organization" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Pending.Organization}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Date Range -->
                <Border Grid.Row="3" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Date Range" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Current.DateRange, Converter={StaticResource DateRangeConverter}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Date Range" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Pending.DateRange, Converter={StaticResource DateRangeConverter}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Summary -->
                <Border Grid.Row="4" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Summary" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Current.Summary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Summary" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Pending.Summary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Skills -->
                <Border Grid.Row="5" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Skills" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SkillsCurrent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Skills" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SkillsPending}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Evidence -->
                <Border Grid.Row="6" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Evidence" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding EvidenceCurrent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Evidence" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding EvidencePending}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                
                <!-- Contexts -->
                <Border Grid.Row="7" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Contexts" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ContextsCurrent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="7" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Contexts" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ContextsPending}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border Grid.Row="8" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Links" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LinksCurrent}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="8" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Links" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LinksPending}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Notes -->
                <Border Grid.Row="9" Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,1,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Current.Notes}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="9" Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="Notes" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PendingExperienceImport.Pending.Notes}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Action buttons -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Keep Existing"
                    HorizontalAlignment="Center"
                    Width="120"
                    Padding="5"
                    Margin="5"
                    Command="{Binding KeepExistingExperienceCommand}"
                    />

            <Button Grid.Column="1"
                    Content="Replace With New"
                    HorizontalAlignment="Center"
                    Width="120"
                    Padding="5"
                    Margin="5"
                    Command="{Binding ReplaceExperienceCommand}"
                    />
        </Grid>

        <!-- Bottom controls -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      Content="Show only differences"
                      HorizontalAlignment="Left"
                      Margin="10"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowOnlyDifferences}"
                      />

            <Button Grid.Column="1"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Width="80"
                    Margin="10"
                    Padding="5"
                    Command="{Binding CloseCommand}"
                    />
        </Grid>
    </Grid>
</Window>
