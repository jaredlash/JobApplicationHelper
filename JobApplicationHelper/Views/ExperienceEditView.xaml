<Window x:Class="JobApplicationHelper.Views.ExperienceEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JobApplicationHelper.Views"
        xmlns:viewmodels="clr-namespace:JobApplicationHelper.ViewModels"
        xmlns:conv="clr-namespace:JobApplicationHelper.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewmodels:ExperienceEditViewModel}"
        Title="Edit Experience"
        Width="760"
        Height="720"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="HelpHintStyle"
           TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <conv:EnumDisplayConverter x:Key="EnumDisplayConverter" />
    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <!-- Title -->
                <RowDefinition Height="Auto"/>
                <!-- Organization -->
                <RowDefinition Height="Auto"/>
                <!-- Type -->
                <RowDefinition Height="Auto"/>
                <!-- Dates -->
                <RowDefinition Height="Auto"/>
                <!-- Summary -->
                <RowDefinition Height="Auto"/>
                <!-- Skills -->
                <RowDefinition Height="Auto"/>
                <!-- Contexts -->
                <RowDefinition Height="Auto"/>
                <!-- Evidence -->
                <RowDefinition Height="Auto"/>
                <!-- Links -->
                <RowDefinition Height="Auto"/>
                <!-- Notes -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Label Grid.Row="0" Content="Title" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Padding="4" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Organization -->
            <Label Grid.Row="1" Content="Organization" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Padding="4" Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Type and Dates -->
            <Label Grid.Row="2" Content="Type" VerticalAlignment="Center" FontWeight="SemiBold"/>

            <Grid Grid.Row="2" Grid.Column="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                    ItemsSource="{Binding AvailableTypes}"
                    SelectedItem="{Binding Type}"
                    VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="1" Text="Dates" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="320" Text="Enter a year (2024), year and month (2024-03), or full date (2024-03-15). Either date can be left blank."/>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="105" ToolTip="Start date, e.g. 2021 or 2021-06" SpellCheck.IsEnabled="False" Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox Width="105" ToolTip="End date, e.g. 2023-09. Leave blank if ongoing." SpellCheck.IsEnabled="False" Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                </StackPanel>
            </Grid>

            <!-- Summary -->
            <Label Grid.Row="4" Content="Summary" VerticalAlignment="Top" FontWeight="SemiBold" />
            <TextBox Grid.Row="4" Grid.Column="1"
                 Margin="5" Padding="4"
                 MinHeight="60" MaxHeight="180"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Skills -->
            <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
                <Label Content="Skills" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource HelpHintStyle}">
                    <Run Text="[?]" BaselineAlignment="Superscript"/>
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                Text="Choose consistent skill names, such as C#, Node.js, or REST APIs. Reuse an existing suggestion when it represents the same skill."/>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="5">
                <TextBlock Text="{Binding SkillsText}" TextWrapping="Wrap"/>
                <Button Content="Edit skills" HorizontalAlignment="Left" Margin="0,5,0,0" Command="{Binding EditSkillsCommand}"/>
            </StackPanel>

            <!-- Contexts -->
            <Label Grid.Row="6" Grid.Column="0" Content="Contexts" VerticalAlignment="Top" FontWeight="SemiBold" />
            <StackPanel Grid.Row="6" Grid.Column="1" Margin="5">
                <TextBlock Text="{Binding ContextsText}" TextWrapping="Wrap" />
                <Button Content="Edit contexts" HorizontalAlignment="Left" Margin="0,5,0,0" Command="{Binding EditContextsCommand}"/>
            </StackPanel>

            <!-- Evidence -->
            <Label Grid.Row="7" Grid.Column="0" Content="Evidence" VerticalAlignment="Top" FontWeight="SemiBold" />
            <StackPanel Grid.Row="7" Grid.Column="1" Margin="5">
                <ItemsControl ItemsSource="{Binding Evidence}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">

                                <Button
                                    DockPanel.Dock="Right"
                                    Margin="5,0,0,0"
                                    Command="{Binding DataContext.RemoveEvidenceCommand,
                                        RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE653;"
                                        FontFamily="Segoe Fluent Icons"
                                        Margin="5"
                                        FontSize="8"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ToolTip="Remove evidence" />
                                </Button>

                                <TextBox TextWrapping="Wrap" MinHeight="20" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Add evidence"
                    HorizontalAlignment="Left"
                    Margin="0,5,0,0"
                    Command="{Binding AddEvidenceCommand}"/>
            </StackPanel>

            <!-- Links -->

            <Label Grid.Row="8" Grid.Column="0" Content="Links" VerticalAlignment="Top" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Margin="5">
                <!--<Label Content="Links" Padding="0"/>-->
                <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">

                                <Button
                                    DockPanel.Dock="Right"
                                    Margin="5,0,0,0"
                                    Command="{Binding DataContext.RemoveLinkCommand,
                                        RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE653;"
                                               FontFamily="Segoe Fluent Icons"
                                               Margin="5"
                                               FontSize="8"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               ToolTip="Remove link"
                                    />
                                </Button>

                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add link"
                    HorizontalAlignment="Left"
                    Margin="0,5,0,0"
                    Command="{Binding AddLinkCommand}"/>
            </StackPanel>

            <!-- Notes -->
            <Label Grid.Row="9" Content="Notes" VerticalAlignment="Top" FontWeight="SemiBold" />
            <TextBox Grid.Row="9" Grid.Column="1"
                 Margin="5" Padding="4"
                 MinHeight="70" MaxHeight="160"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Save / Cancel -->
            <StackPanel Grid.Row="10" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="5,15,5,5">
                <Button Content="Cancel"
                    MinWidth="85" Margin="5"
                    Command="{Binding CancelCommand}"/>
                <Button Content="Save"
                    MinWidth="85" Margin="5"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
