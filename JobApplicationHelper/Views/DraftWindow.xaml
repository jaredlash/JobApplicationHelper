<Window x:Class="JobApplicationHelper.Views.DraftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JobApplicationHelper"
        xmlns:conv="clr-namespace:JobApplicationHelper.Converters"
        xmlns:viewModels="clr-namespace:JobApplicationHelper.ViewModels"
        xmlns:views="clr-namespace:JobApplicationHelper.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:DraftWindowViewModel}"
        Title="DraftWindow"
        Height="650"
        Width="800">

    <Window.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplayConverter" />
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    TabStripPlacement="Top">

            <!-- Hide the tab headers -->
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabControl">
                                <Grid KeyboardNavigation.TabNavigation="Local">
                                    <ContentPresenter Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Style>

            <TabItem>
                <views:JobRequirementsView />
            </TabItem>

            <TabItem Margin="-2,-2,-2,2">
                <views:CoverLetterView />
            </TabItem>

        </TabControl>

        <!-- Bottom status/load area -->
        <Grid Grid.Row="1"
              Grid.Column="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Margin="5"
                    Command="{Binding LoadJobRequirementsCommand}">
                <TextBlock Text="&#xE117;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="10"
                           Margin="5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Button>

            <Label Grid.Column="1"
                   Margin="5"
                   Content="{Binding StatusMessage}"
                   HorizontalAlignment="Left"/>
        </Grid>

    </Grid>
</Window>