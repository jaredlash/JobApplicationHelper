<Window x:Class="JobApplicationHelper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JobApplicationHelper"
        xmlns:behaviors="clr-namespace:JobApplicationHelper.Behaviors"
        xmlns:viewModels="clr-namespace:JobApplicationHelper.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
        Title="MainWindow" Height="500" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Margin="5" Content="Country:"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" Width="150" HorizontalAlignment="Left"
                  ItemsSource="{Binding Locations}" 
                  DisplayMemberPath="CountryName"
                  SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"/>
        <Label Grid.Row="1" Grid.Column="0" Margin="5" Content="City:"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" HorizontalAlignment="Stretch"
                 Text="{Binding City, Mode=TwoWay}"/>
        <Label Grid.Row="2" Grid.Column="0" Margin="5" Content="Job Title:"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="5" HorizontalAlignment="Stretch"
                 Text="{Binding PositionTitle, Mode=TwoWay}"/>
        <Label Grid.Row="3" Grid.Column="0" Margin="5" Content="Company Name:"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="5" HorizontalAlignment="Stretch"
                 Text="{Binding CompanyName, Mode=TwoWay}"/>
        <Label Grid.Row="4" Grid.Column="0" Margin="5" Content="URL:"/>
        <TextBox Grid.Row="4" Grid.Column="1" Margin="5" HorizontalAlignment="Stretch"
                 Text="{Binding Url, Mode=TwoWay}"/>
        <CheckBox Grid.Row="5" Grid.Column="1" Margin="5" Content="Include cover letter" 
                  IsChecked="{Binding IncludeCoverLetter, Mode=TwoWay}"/>
        <Label Grid.Row="6" Grid.Column="0" Margin="5" Content="Job Posting:" Visibility="{Binding IncludeCoverLetter, Converter={StaticResource BoolToVis}}"/>
        <TextBox Grid.Row="6" Grid.Column="1" Visibility="{Binding IncludeCoverLetter, Converter={StaticResource BoolToVis}}"
            Text="{Binding JobPosting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            Height="200"
            Margin="5" 
            behaviors:PasteAsMarkdownBehavior.IsEnabled="True"
         />

        <Button Grid.Row="9" Grid.Column="0" Margin="5" Width="100" Content="Reset Form" 
                Command="{Binding ResetFormCommand}"/>
        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox Margin="5" VerticalAlignment="Center" Content="Open Folder" 
                      IsChecked="{Binding OpenNewFolder, Mode=TwoWay}"/>
            <Button Margin="5" Padding="5" Width="Auto" Content="Create Application Folder" 
                    Command="{Binding CreateApplicationCommand}"/>
        </StackPanel>
        <Label Grid.Row="10" Grid.Column="0" Margin="5" Content="{Binding StatusMessage}" Grid.ColumnSpan="2" HorizontalAlignment="Left"/>
    </Grid>
</Window>
