<Window x:Class="JobApplicationHelper.Views.ConfirmDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JobApplicationHelper.Views"
        xmlns:viewmodels="clr-namespace:JobApplicationHelper.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewmodels:ConfirmDialogViewModel}"
        Title="{Binding Title}"
        Width="400"
        MinWidth="300"
        MaxWidth="600"
        MinHeight="150"
        MaxHeight="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Border Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Message}"/>
            <Separator Grid.Row="1"/>
            <!-- Status row and Save/Cancel buttons -->

            <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft">

                <!-- Ok and Cancel buttons -->
                <Button Margin="0 10 5 0" Padding="5" MinWidth="80" Command="{Binding YesCommand}" Content="{Binding Path=YesText, Mode=OneWay, FallbackValue='Yes'}" />
                <Button Margin="5 10 0 0" Padding="5" MinWidth="80" Command="{Binding NoCommand}" Content="{Binding Path=NoText, Mode=OneWay, FallbackValue='No'}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
